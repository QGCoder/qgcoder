# Doxygen configuration for qgcoder.
#
# Only the settings that differ from the defaults are listed, so this stays
# readable and does not have to be regenerated whenever doxygen adds a tag.
# Run it from the top of the source tree:
#
#     doxygen
#
# and open doc/html/index.html.

PROJECT_NAME           = qgcoder
PROJECT_BRIEF          = "An interactive G-code editing GUI"

# The sources. The RS274NGC interpreter vendored from NIST is excluded: it is
# third-party code carried as it came - it is built with warnings off for the
# same reason - and documenting it would be churn that re-vendoring discards.
# rs274ngc_interp.* is ours, the in-process driver that replaces its driver.cc,
# so it stays in.
INPUT                  = src
RECURSIVE              = YES
EXCLUDE                = src/rs274ngc/canon.hh \
                         src/rs274ngc/canon_pre.cc \
                         src/rs274ngc/rs274ngc.hh \
                         src/rs274ngc/rs274ngc_errors.cc \
                         src/rs274ngc/rs274ngc_pre.cc \
                         src/rs274ngc/rs274ngc_return.hh

OUTPUT_DIRECTORY       = doc
GENERATE_LATEX         = NO

# Document what is actually documented, and say so when something is not. The
# tree is clean under these, so a fresh warning means a fresh gap.
EXTRACT_ALL            = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES

# Private members and file-scope helpers are part of how this code works.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES

SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
